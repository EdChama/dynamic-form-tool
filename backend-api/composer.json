{
  "name": "rift/dynamic-form-backend",
  "description": "CodeIgniter-oriented REST API for the Dynamic Form Builder Engine.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "codeigniter4/framework": "^4.5",
    "codeigniter4/shield": "^1.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpunit/phpunit": true
    }
  }
}
