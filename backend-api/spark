#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Database\Database;

require __DIR__ . '/vendor/autoload.php';

$command = $argv[1] ?? 'help';
$database = new Database();
$pdo = $database->pdo();

$runSqlFiles = static function (string $directory, bool $track = false) use ($pdo): void {
    $files = glob($directory . '/*.sql') ?: [];
    sort($files);

    if ($track) {
        $pdo->exec(<<<'SQL'
            CREATE TABLE IF NOT EXISTS schema_migrations (
                migration varchar(255) PRIMARY KEY,
                executed_at timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP
            )
        SQL);
    }

    foreach ($files as $file) {
        $migration = basename($file);
        if ($track) {
            $statement = $pdo->prepare('SELECT COUNT(*) FROM schema_migrations WHERE migration = :migration');
            $statement->execute(['migration' => $migration]);
            if ((int) $statement->fetchColumn() > 0) {
                echo $migration . " skipped" . PHP_EOL;
                continue;
            }
        }

        $sql = file_get_contents($file);
        if ($sql === false) {
            throw new RuntimeException("Unable to read {$file}");
        }

        $pdo->exec($sql);
        if ($track) {
            $statement = $pdo->prepare('INSERT INTO schema_migrations (migration) VALUES (:migration)');
            $statement->execute(['migration' => $migration]);
        }

        echo $migration . PHP_EOL;
    }
};

try {
    if ($command === 'migrate') {
        $runSqlFiles(__DIR__ . '/database/migrations', true);
        echo "Migrations complete." . PHP_EOL;
        exit(0);
    }

    if ($command === 'db:seed') {
        $runSqlFiles(__DIR__ . '/database/seeds');
        echo "Seed data complete." . PHP_EOL;
        exit(0);
    }

    if ($command === 'serve') {
        $host = '0.0.0.0';
        $port = '8080';
        passthru("php -S {$host}:{$port} -t public");
        exit(0);
    }

    echo "Available commands: migrate, db:seed, serve" . PHP_EOL;
    exit(0);
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(1);
}
